@{
    @model ICollection<CustomerDTO>
}
@{
    ViewData["Title"] = "Create Customer";
}

<div class="max-w-3xl mx-auto mt-10 bg-white shadow-lg rounded-lg p-8">

    <h2 class="text-3xl font-bold text-center text-blue-600 mb-6">
        Register Customer
    </h2>

    <form asp-action="Create" method="post">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <label name ="FirstName" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="FirstName"
                       class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label name="LastName" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="LastName"
                       class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label name="Email" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="Email"
                       class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label name="PhoneNumber" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="PhoneNumber"
                       class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2">
                <label name="Address" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <textarea name="Address"
                          rows="3"
                          class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div>
                <label name="Password" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="Password"
                       type="password"
                       class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>

        <div class="mt-8 flex justify-between">

            <a asp-action="Index"
               class="bg-gray-500 text-white px-6 py-2 rounded-lg hover:bg-gray-600">
                Back to List
            </a>

            <button type="submit"
                    class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                Create Customer
            </button>

        </div>

    </form>

</div>

