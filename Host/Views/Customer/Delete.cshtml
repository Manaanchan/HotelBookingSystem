@{
    @model CustomerResponseModel
}
@{
    ViewData["Title"] = "Delete Customer";
}

<div class="max-w-3xl mx-auto mt-10">
    <div class="bg-white shadow-lg rounded-lg p-8">

        <h2 class="text-3xl font-bold text-red-600 mb-4">
            Delete Customer
        </h2>

        <p class="text-lg text-gray-700 mb-6">
            Are you sure you want to delete this customer?
        </p>

        <div class="border rounded-lg p-6 bg-gray-50">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label class="font-semibold text-gray-700">Full Name</label>
                    <p class="mt-1 text-gray-900">@Model.FirstName</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Full Name</label>
                    <p class="mt-1 text-gray-900">@Model.LastName</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Email</label>
                    <p class="mt-1 text-gray-900">@Model.Email</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Phone Number</label>
                    <p class="mt-1 text-gray-900">@Model.PhoneNumber</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Address</label>
                    <p class="mt-1 text-gray-900">@Model.Address</p>
                </div>

            </div>

        </div>

        <form asp-action="Delete" method="post" class="mt-8">

            <input type="hidden" asp-for="Id" />

            <div class="flex justify-between">

                <a asp-action="Index"
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg">
                    Cancel
                </a>

                <button type="submit"
                        class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg">
                    Delete Customer
                </button>

            </div>

        </form>

    </div>
</div>
}
