@{
    @model ICollection<RoleDTO>
}
@{
    ViewData["Title"] = "Create Role";
}

<div class="max-w-2xl mx-auto mt-10 bg-white shadow-lg rounded-lg p-8">

    <h2 class="text-3xl font-bold text-center text-blue-600 mb-6">
        Create Role
    </h2>

    <form asp-action="Create" method="post">
        <div class="mb-5">
            <label name="Name" 
                class="block text-gray-700 font-semibold mb-2"></label>
            <input ="Name"
                   class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="mb-5">
            <label name="Description"
                class="block text-gray-700 font-semibold mb-2"></label>
            <textarea name="Description"
                      rows="4"
                      class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <div class="flex justify-between mt-6">

            <a asp-action="Index"
               class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg">
                Back to List
            </a>

            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                Create Role
            </button>

        </div>

    </form>

</div>

