@{
    @model RoleResponseModel
}
@{
    ViewData["Title"] = "Delete Role";
}

<div class="max-w-2xl mx-auto mt-10">
    <div class="bg-white shadow-lg rounded-lg p-8">

        <h2 class="text-3xl font-bold text-red-600 text-center mb-6">
            Delete Role
        </h2>

        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
            <strong>Warning!</strong> Are you sure you want to delete this role?
        </div>

        <dl class="grid grid-cols-1 gap-4">

            <div>
                <dt class="font-semibold text-gray-700">
                    Role Name
                </dt>
                <dd class="mt-1 text-gray-900">
                    @Model.Name
                </dd>
            </div>

            <div>
                <dt class="font-semibold text-gray-700">
                    Description
                </dt>
                <dd class="mt-1 text-gray-900">
                    @Model.Description
                </dd>
            </div>

        </dl>

        <form asp-action="Delete" method="post" class="mt-8">

            <input type="hidden" asp-for="Id" />

            <div class="flex justify-between">

                <a asp-action="Index"
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg">
                    Cancel
                </a>

                <button type="submit"
                        class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg">
                    Delete Role
                </button>

            </div>

        </form>

    </div>
</div>