@{
    @model ICollection<PaymentResponseModel>
@{
    ViewData["Title"] = "Payments";
}

<div class="container mx-auto px-6 py-8">

    <div class="flex items-center justify-between mb-6">
        <h2 class="text-3xl font-bold text-gray-800">
            Payment List
        </h2>

        <a asp-action="Create"
           class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow">
            + Make Payment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-lg bg-green-100 border border-green-400 text-green-700 px-4 py-3">
            @TempData["Success"]
        </div>
    }

    <div class="overflow-x-auto bg-white rounded-lg shadow-lg">

        <table class="min-w-full">

            <thead class="bg-gray-800 text-white">
                <tr>
                    <th class="px-6 py-3 text-left">S/N</th>
                    <th class="px-6 py-3 text-left">Booking</th>
                    <th class="px-6 py-3 text-left">Amount</th>
                    <th class="px-6 py-3 text-left">Payment Method</th>
                    <th class="px-6 py-3 text-left">Reference</th>
                    <th class="px-6 py-3 text-left">Payment Date</th>
                    <th class="px-6 py-3 text-left">Status</th>
                    <th class="px-6 py-3 text-center">Actions</th>
                </tr>
            </thead>
            
             <tbody class="divide-y divide-gray-200">
                @{
                    int count = 1;
                }

                @foreach (var payment in Model)
                {
                    <tr class="border-b hover:bg-gray-100">

                        <td class="px-6 py-4">
                            @count
                        </td>

                        <td class="px-6 py-4">
                            ₦@payment.Amount.ToString("N2")
                        </td>

                        <td class="px-6 py-4">
                            @payment.PaymentMethod
                        </td>

                        <td class="px-6 py-4">
                            @payment.TransactionReference
                        </td>

                        <td class="px-6 py-4">
                            @payment.PaymentDate.ToString("dd MMM yyyy")
                        </td>

                        <td class="px-6 py-4">
                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">
                                @payment.Status
                            </span>
                        </td>

                        <td class="px-6 py-4 text-center space-x-2">

                            <a asp-action="Delete"
                               asp-route-id="@payment.Id"
                               class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded">
                                Delete
                            </a>

                        </td>

                    </tr>

                    count++;
                }

            </tbody>

        </table>

    </div>

</div>