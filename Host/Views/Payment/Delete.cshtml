@{
    @model PaymentResponseModel
}
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="max-w-3xl mx-auto mt-10">

    <div class="bg-white shadow-lg rounded-lg p-8">

        <h2 class="text-3xl font-bold text-red-600 mb-4">
            Delete Payment
        </h2>

        <p class="text-lg text-gray-700 mb-6">
            Are you sure you want to delete this payment?
        </p>

        <div class="bg-gray-50 border rounded-lg p-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label class="font-semibold text-gray-700">Amount</label>
                    <p class="mt-1">₦@Model.Amount.ToString("N2")</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Payment Method</label>
                    <p class="mt-1">@Model.PaymentMethod</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Transaction Reference</label>
                    <p class="mt-1">@Model.TransactionReference</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Payment Date</label>
                    <p class="mt-1">@Model.PaymentDate.ToString("dd MMM yyyy")</p>
                </div>

                <div>
                    <label class="font-semibold text-gray-700">Status</label>
                    <p class="mt-1">@Model.Status</p>
                </div>

            </div>

        </div>

        <form asp-action="Delete" method="post" class="mt-8">

            <input asp-for="Id" type="hidden" />

            <div class="flex justify-between">

                <a asp-action="Index"
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg">
                    Cancel
                </a>

                <button type="submit"
                        class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg">
                    Delete Payment
                </button>

            </div>

        </form>

    </div>

</div>

