@{
    @model ICollection<RoomDTO>
}
@{
    ViewData["Title"] = "Create Room";
}

<div class="max-w-3xl mx-auto mt-10 bg-white shadow-lg rounded-lg p-8">

    <h2 class="text-3xl font-bold text-center text-blue-600 mb-6">
        Create Room
    </h2>

    <form asp-action="Create" method="post">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <label name="RoomNumber"
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="RoomNumber"
                       class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label name="RoomTypeId" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <select name="RoomTypeId"
                        asp-items="ViewBag.RoomTypes"
                        class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500">
                    <option value="">-- Select Room Type --</option>
                </select>
            </div>

            <div>
                <label name="PricePerNight" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="PricePerNight"
                       class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label name="Capacity" 
                    class="block text-gray-700 font-semibold mb-2"></label>
                <input name="Capacity"
                       class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="md:col-span-2">
                <label name="Price"
                    class="block text-gray-700 font-semibold mb-2"></label>
                <textarea name="price"
                          rows="4"
                          class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div class="md:col-span-2 flex items-center">
                <input name="IsAvailable"
                       class="mr-2 h-5 w-5 text-blue-600 border-gray-300 rounded" />
                    Available
                </label>
            </div>

        </div>

        <div class="mt-8 flex justify-between">

            <a asp-action="Index"
               class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg">
                Back to List
            </a>

            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                Create Room
            </button>

        </div>

    </form>

</div>

