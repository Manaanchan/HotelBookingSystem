@{
    @model ICollection<RoomResponseModel>
}
@{
    ViewData["Title"] = "Rooms";
}

<div class="container mx-auto px-6 py-8">

    <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold text-gray-800">
            Room Management
        </h2>

        <a asp-action="Create"
           class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow">
            + Create Room
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
            @TempData["Success"]
        </div>
    }

    <div class="overflow-x-auto bg-white shadow-lg rounded-lg">

        <table class="min-w-full divide-y divide-gray-200">

            <thead class="bg-gray-800 text-white">
                <tr>
                    <th class="px-6 py-3 text-left">S/N</th>
                    <th class="px-6 py-3 text-left">Room Number</th>
                    <th class="px-6 py-3 text-left">Room Type</th>
                    <th class="px-6 py-3 text-left">Price/Night</th>
                    <th class="px-6 py-3 text-left">Capacity</th>
                    <th class="px-6 py-3 text-left">Availability</th>
                    <th class="px-6 py-3 text-center">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-gray-200">

                @{
                    int count = 1;
                }

                @foreach (var room in Model)
                {
                    <tr class="hover:bg-gray-100">

                        <td class="px-6 py-4">
                            @count
                        </td>

                        <td class="px-6 py-4">
                            @room.RoomNumber
                        </td>

                        <td class="px-6 py-4">
                            @room.RoomTypeId
                        </td>

                        <td class="px-6 py-4">
                            ₦@room.PricePerNight.ToString("N2")
                        </td>

                        <td class="px-6 py-4">
                            @room.Capacity
                        </td>

                        <td class="px-6 py-4">
                            @if (room.IsAvailable)
                            {
                                <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm">
                                    Occupied
                                </span>
                            }
                        </td>

                        <td class="px-6 py-4 text-center space-x-2">
                            <a asp-action="Delete"
                               asp-route-id="@room.Id"
                               class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded">
                                Delete
                            </a>

                        </td>

                    </tr>

                    count++;
                }

            </tbody>

        </table>

    </div>

</div>