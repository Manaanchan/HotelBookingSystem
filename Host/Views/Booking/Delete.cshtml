@{
    @model BookingResponseModel
}
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="max-w-3xl mx-auto mt-10">

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">

        <div class="bg-red-600 text-white px-6 py-4">
            <h2 class="text-2xl font-bold">Delete Booking</h2>
        </div>

        <div class="p-6">

            <div class="bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded mb-6">
                <strong>Warning!</strong> Are you sure you want to delete this booking?
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <div>
                    <p class="text-gray-500 text-sm">Room Number</p>
                    <p class="font-semibold">@Model.RoomNumber</p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">Room Type</p>
                    <p class="font-semibold">@Model.RoomType</p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">Check-In Date</p>
                    <p class="font-semibold">
                        @Model.CheckInDate.ToString("dd MMM yyyy")
                    </p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">Check-Out Date</p>
                    <p class="font-semibold">
                        @Model.CheckOutDate.ToString("dd MMM yyyy")
                    </p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">Number of Guests</p>
                    <p class="font-semibold">@Model.NumberOfGuests</p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">Total Price</p>
                    <p class="font-semibold text-green-600">
                        ₦@Model.TotalAmount
                    </p>
                </div>

                <div>
                    <p class="text-gray-500 text-sm">BookingStatus</p>
                    <p class="font-semibold">@Model.BookingStatus</p>
                </div>

            </div>

            <form asp-action="Delete" method="post" class="mt-8">

                <input type="hidden" asp-for="Id" />

                <div class="flex justify-between">

                    <a asp-action="Index"
                       class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2 rounded-lg">
                        Cancel
                    </a>

                    <button type="submit"
                            class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg">
                        Delete Booking
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
}
