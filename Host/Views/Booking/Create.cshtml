@{
    @model ICollection<BookingDTO>
}
@{
    ViewData["Title"] = "Create Booking";
}

<div class="max-w-3xl mx-auto mt-10 bg-white shadow-lg rounded-lg p-8">

    <h2 class="text-3xl font-bold text-center text-blue-700 mb-8">
        Create Booking
    </h2>

    <form asp-action="Create" method="post" class="space-y-6">

        <div>
            <label name="cutomerId"
                   class="block text-sm font-medium text-gray-700 mb-2">
                Customer
            </label>

            <select name="cutomerId"
                    asp-items="ViewBag.Customers"
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="">-- Select Customer --</option>
            </select>

        </div>

        <div>
            <label name="roomId" class="block text-sm font-medium text-gray-700 mb-2">
                Room
            </label>

            <select name="RoomId"
                    asp-items="ViewBag.Rooms"
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="">-- Select Room --</option>
            </select>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div>
                <label name="CheckInDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Check-In Date
                </label>

                <input name="CheckInDate"
                       type="date"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:outline-none" />


            </div>

            <div>
                <label name="CheckOutDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Check-Out Date
                </label>

                <input name="CheckOutDate"
                       type="date"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:outline-none" />

            </div>

        </div>

        <div>
            <label name="NumberOfGuests" class="block text-sm font-medium text-gray-700 mb-2">
                Number of Guests
            </label>

            <input name="NumberOfGuests"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                   placeholder="Enter number of guests" />

            <span name="NumberOfGuests" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-between pt-6">

            <a asp-action="Index"
               class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg">
                Back
            </a>

            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg">
                Create Booking
            </button>

        </div>

    </form>

</div>


